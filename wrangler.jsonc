{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "snapee",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "snapee.fyi",
      "custom_domain": true
    },
    {
      "pattern": "www.snapee.fyi",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "0 */3 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snapee",
      "database_id": "dccf1562-89bf-4e08-a707-dc0d1bfba6a3"
    }
  ],
  "vars": {
    "SWEEP_ENABLED": "false",
    "APIFY_SHOPEE_ACTOR": "xtracto/shopee-scraper",
    "APIFY_THREADS_ACTOR": "",
    "OPENAI_MODEL": "gpt-6-astra",
    "OPENAI_PRICE_MODEL": "gpt-5-mini",
    "MAIL_FROM": "Snapee <no-reply@snapee.fyi>"
  }
}
